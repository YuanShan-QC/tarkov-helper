@echo off
setlocal

rem ============================================================
rem  塔科夫市场查询助手 - 停止服务脚本
rem  用法：双击本文件，停止后端（8100）服务
rem ============================================================

echo ================================================
echo    塔科夫市场查询助手 - 停止服务
echo ================================================
echo.

rem ----- 停止后端（8100 端口）-----
echo [1/1] 正在停止后端服务（端口 8100）...
set "found="
for /f "tokens=5" %%a in ('netstat -ano ^| findstr ":8100" ^| findstr "LISTENING"') do (
    set "found=1"
    taskkill /F /PID %%a >nul 2>nul
    echo        已停止进程 PID %%a
)
if not defined found echo        后端服务未在运行

echo.
echo ================================================
echo    完成！服务已停止。
echo ================================================
echo.
pause

endlocal
